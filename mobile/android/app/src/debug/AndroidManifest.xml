<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- DEV UNIQUEMENT : autorise le HTTP non-sécurisé (cleartext) vers le backend local.
         Android 9+ (API 28+) le bloque par défaut. Ne concerne QUE les builds debug
         (ce fichier) → en prod (release) on reste en HTTPS, rien à changer côté sécurité. -->
    <application android:usesCleartextTraffic="true" />
</manifest>
